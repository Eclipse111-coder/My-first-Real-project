<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<GridPane fx:id="rootPane" alignment="center" hgap="10" vgap="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.passwordman.fxmlpratcise.loginMenuController">
   <padding><Insets bottom="10" left="25" right="25" top="25" /></padding>
   <Text text="Welcome" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0" />

   <Label text="User name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
   <TextField fx:id="userNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

   <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
   <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
   <Button onAction="#loginAction" text="Login" GridPane.columnIndex="1" GridPane.rowIndex="3" />
   <columnConstraints>
      <ColumnConstraints />
      <ColumnConstraints />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
   </rowConstraints>
</GridPane>
